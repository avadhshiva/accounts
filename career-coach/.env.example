# Pathly env example

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars

# --- Database (required in production) ---
# Supabase: Project Settings → Database → Connection string (URI)
# Use the "Transaction" pooler URL for serverless/Render if available.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# Local dev only: omit DATABASE_URL and set explicit JSON fallback (NOT for production)
# STORAGE_BACKEND=json

# Optional: disable SSL for local Postgres only
# PGSSLMODE=disable

GEMINI_API_KEY=
OPENAI_API_KEY=
# Local development ONLY: allow mock AI scores when no provider is available. Ignored in production.
# ALLOW_MOCK_AI=true

# Pilot feedback mode (hides payment UI). Default true.
PILOT_MODE=true
# 7 days = 10080 minutes (pilot cohort)
TRIAL_MINUTES=10080

UNLOCK_PRICE_INR=500
# Comma-separated invite codes. EMPTY (default) disables invite redemption.
# Production codes must be private, strong random values (e.g. `openssl rand -hex 12`); never commit real codes.
INVITE_CODES=
ALLOW_MANUAL_UNLOCK=false
ALLOW_TEST_PRO=false

# Optional Google Form (button on /feedback). Leave empty to use in-app form only.
NEXT_PUBLIC_FEEDBACK_FORM_URL=

NEXT_PUBLIC_UPI_ID=yourname@upi
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=LaunchRole

# Password reset emails are sent through Brevo or Resend (plain HTTPS APIs, so they work on Render free tier).

# Option A (FREE, no domain, works on Render free): Brevo
# 1) Sign up at https://www.brevo.com (free)
# 2) Senders → Add sender → your Gmail → verify via link in inbox
# 3) SMTP & API → API keys → Create
EMAIL_PROVIDER=brevo
BREVO_API_KEY=xkeysib-...
BREVO_SENDER_EMAIL=yourname@gmail.com

# Option B: Resend — without a verified domain, only delivers to your Resend signup email
RESEND_API_KEY=
EMAIL_FROM=LaunchRole <onboarding@resend.dev>
