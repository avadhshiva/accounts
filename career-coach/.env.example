# Pathly env example

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
GEMINI_API_KEY=
OPENAI_API_KEY=

# Pilot feedback mode (hides payment UI). Default true.
PILOT_MODE=true
# 48 hours = 2880 minutes
TRIAL_MINUTES=2880

UNLOCK_PRICE_INR=500
INVITE_CODES=PATHLY-DEMO,PATHLY-STUDENT
ALLOW_MANUAL_UNLOCK=false
ALLOW_TEST_PRO=true

# Optional Google Form (button on /feedback). Leave empty to use in-app form only.
NEXT_PUBLIC_FEEDBACK_FORM_URL=

NEXT_PUBLIC_UPI_ID=yourname@upi
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pathly

# Password reset emails — pick ONE option for pilot:

# Option A (FREE, no domain): Gmail SMTP — works for wife + all students
# 1) Turn on 2-Step Verification on your Google account
# 2) Create App Password: https://myaccount.google.com/apppasswords
# 3) Set both vars below (use the 16-char app password, not your normal Gmail password)
GMAIL_USER=yourname@gmail.com
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx
EMAIL_PROVIDER=gmail

# Option B (later): Resend with your own verified domain
RESEND_API_KEY=
EMAIL_FROM=Pathly <onboarding@resend.dev>
