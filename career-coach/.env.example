# Environment variables declared in this file are NOT automatically loaded by Prisma.
# Pathly local / deploy env example

AUTH_SECRET=change-me-to-a-long-random-string-at-least-32-chars
GEMINI_API_KEY=
OPENAI_API_KEY=

# Trial + unlock
TRIAL_MINUTES=30
UNLOCK_PRICE_INR=500
INVITE_CODES=PATHLY-DEMO,PATHLY-STUDENT
ALLOW_MANUAL_UNLOCK=true
ALLOW_TEST_PRO=true
NEXT_PUBLIC_UPI_ID=yourname@upi
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Pathly
